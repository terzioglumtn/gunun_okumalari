<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.title }}{% endblock %}</title>
<meta name="description" content="{% block desc %}{{ site.subtitle }}{% endblock %}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.desc() }}">
<meta property="og:type" content="website">
<script>try{var t=localStorage.getItem("tema");if(t)document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
<link rel="stylesheet" href="{{ base }}style.css">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ base }}feed.xml">
</head>
<body>
<div class="wrap">
  <header>
    <div class="top">
      <a class="brand" href="{{ base or './' }}">{{ site.title }}</a>
      <nav><a href="{{ base }}arama.html">Ara</a><a href="{{ base }}arsiv/">Arşiv</a><a href="{{ base }}feed.xml">RSS</a>
        <button type="button" class="icon-btn" id="share" aria-label="Paylaş" title="Paylaş"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v14"/></svg></button>
        <button type="button" class="icon-btn" id="theme" aria-label="Temayı değiştir" title="Temayı değiştir"><svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      </nav>
    </div>
    {% block header %}{% endblock %}
  </header>
  <main>
  {% block content %}{% endblock %}
  </main>
  <footer>
    {% block footer %}{% endblock %}
    <p>Yapay zekâ ile derlenmiştir. Özetler kaynak metne dayanır ancak hata içerebilir;
    karar vermeden önce orijinal kaynağa bakın. Her maddenin başlığı asıl habere gider.</p>
  </footer>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
(function(){
  var root=document.documentElement, toast=document.getElementById("toast"), tm;
  function say(m){toast.textContent=m;toast.classList.add("show");clearTimeout(tm);tm=setTimeout(function(){toast.classList.remove("show")},1800);}
  function isDark(){var t=root.getAttribute("data-theme");return t?t==="dark":matchMedia("(prefers-color-scheme: dark)").matches;}
  document.getElementById("theme").addEventListener("click",function(){
    var t=isDark()?"light":"dark"; root.setAttribute("data-theme",t);
    try{localStorage.setItem("tema",t)}catch(e){}
  });
  document.getElementById("share").addEventListener("click",function(){
    var url=location.href.split("#")[0], title=document.title;
    if(navigator.share){navigator.share({title:title,url:url}).catch(function(){});return;}
    if(navigator.clipboard){navigator.clipboard.writeText(url).then(function(){say("Bağlantı kopyalandı")},function(){say(url)});}
    else say(url);
  });
})();
</script>
</body>
</html>
