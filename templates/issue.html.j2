{% extends "layout.html.j2" %}
{% block title %}{{ v.date_tr }} · {{ site.title }}{% endblock %}
{% block desc %}{{ v.count }} maddelik günlük okuma listesi, Sayı {{ v.issue_no }}.{% endblock %}

{% macro kind_tag(it) %}{% if it.kind == "qa" %}<span class="tag">Soru-cevap</span>{% elif it.kind == "repo" %}<span class="tag">Depo</span>{% elif it.kind == "medium" %}<span class="tag">Medium</span>{% elif it.kind == "preview" %}<span class="tag">Ön izleme</span>{% endif %}{% endmacro %}

{% macro meta(it) %}
<p class="meta"><span class="dot" data-topic="{{ it.topic }}"></span><span class="src">{{ it.source }}</span>{% if it.via %}<span class="via"> · {{ it.via }}</span>{% endif %}
  {{ kind_tag(it) }}{% for t in it.get("tags", []) %}<span class="tag">{{ t }}</span>{% endfor %}</p>
{% endmacro %}

{% macro card(it) %}
<article class="card" data-topic="{{ it.topic }}">
  {{ meta(it) }}
  <h3><a href="{{ it.url|safe_url }}" target="_blank" rel="noopener">{{ it.title_tr }}</a></h3>
  {% if it.title_orig and it.title_orig != it.title_tr %}<p class="orig">{{ it.title_orig }}</p>{% endif %}
  <p class="sum">{{ it.summary_tr }}</p>
  {% if it.why_tr %}<p class="why"><b>Neden önemli</b>{{ it.why_tr }}</p>{% endif %}
</article>
{% endmacro %}

{% macro compact(it, featured=False) %}
<details class="item{{ ' featured' if featured }}" id="m-{{ it.id }}" data-topic="{{ it.topic }}">
  <summary>
    {% if featured %}<span class="star">★ Önce Bunlar'da</span>{% endif %}
    {{ meta(it) }}
    <span class="t">{{ it.title_tr }}</span>
    <span class="teaser">{{ it.summary_tr|teaser }}</span>
  </summary>
  <div class="body">
    {% if it.title_orig and it.title_orig != it.title_tr %}<p class="orig">{{ it.title_orig }}</p>{% endif %}
    <p class="sum">{{ it.summary_tr }}</p>
    {% if it.why_tr %}<p class="why"><b>Neden önemli</b>{{ it.why_tr }}</p>{% endif %}
    <a class="go" href="{{ it.url|safe_url }}" target="_blank" rel="noopener">Kaynağa git <span aria-hidden="true">↗</span></a>
  </div>
</details>
{% endmacro %}

{% block header %}
<div class="hero">
  <p class="label">{{ v.weekday }} · Sayı {{ v.issue_no }}</p>
  <h1>{{ v.date_tr }}</h1>
  <p class="stats"><b>{{ v.count }}</b> madde<span>·</span><b>{{ v.filled }}</b>/{{ v.groups|length }} alan dolu{% if v.top %}<span>·</span><b>{{ v.top|length }}</b> öne çıkan{% endif %}</p>
</div>
{% endblock %}

{% block content %}
{% if v.groups %}
<nav class="sections" aria-label="Bölümler">
  {% if v.top %}<a href="#once-bunlar">Önce Bunlar</a>{% endif %}
  {% if v.repo %}<a href="#bugunun-deposu">Depo</a>{% endif %}
  {% for g in v.groups %}<a href="#a-{{ g.key }}" data-topic="{{ g.key }}" class="{{ '' if g.entries else 'is-empty' }}"><span class="dot" data-topic="{{ g.key }}"></span>{{ g.short }}<span class="n">{{ g.entries|length }}</span></a>{% endfor %}
</nav>
{% endif %}

{% if v.top %}
<section class="block" id="once-bunlar">
  <div class="block-head"><h2>Önce Bunlar</h2><p class="lede">Vaktiniz kısaysa yalnızca bu {{ v.top|length }} maddeyi okuyun.</p></div>
  <div class="grid-cards">{% for it in v.top %}{{ card(it) }}{% endfor %}</div>
</section>
{% endif %}

{% if v.repo %}
<section class="block repo" id="bugunun-deposu">
  <div class="block-head"><h2>Bugünün Deposu</h2><p class="lede">GitHub Trending (haftalık) listesinden günün seçimi.</p></div>
  {{ card(v.repo) }}
</section>
{% endif %}

{% for g in v.groups %}
<section class="block topic{{ ' is-empty' if not g.entries }}" id="a-{{ g.key }}" data-topic="{{ g.key }}">
  <div class="block-head">
    <h2><span class="bar" data-topic="{{ g.key }}"></span>{{ g.title }}</h2>
    <span class="count">{{ g.entries|length }}{% if g.max %}<small>/{{ g.max }}</small>{% endif %}</span>
  </div>
  {% if not g.entries %}<p class="empty">Bugün bu alanda eşiği geçen yazı çıkmadı.</p>{% endif %}
  {% if g.entries %}<div class="grid-items">{% for it in g.entries %}{{ compact(it, it.id in v.top_ids) }}{% endfor %}</div>{% endif %}
</section>
{% endfor %}

{% if not v.groups and not v.repo %}
<p class="empty">Bugün seçilecek yeterince değerli madde bulunamadı.</p>
{% endif %}

<nav class="pager">
  {% if older %}<a href="{{ base }}arsiv/{{ older.date }}.html">← {{ older.date_tr }}</a>{% else %}<span></span>{% endif %}
  {% if newer %}<a href="{{ base }}arsiv/{{ newer.date }}.html">{{ newer.date_tr }} →</a>{% endif %}
</nav>

<script>
(function(){ // menüde görünen bölümü vurgula
  var links=[].slice.call(document.querySelectorAll(".sections a")); if(!("IntersectionObserver" in window)||!links.length)return;
  var map={}; links.forEach(function(a){map[a.getAttribute("href").slice(1)]=a;});
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){
    links.forEach(function(a){a.classList.remove("on");}); var a=map[e.target.id]; if(a){a.classList.add("on");
    var nav=a.parentNode, l=a.offsetLeft, r=l+a.offsetWidth;
    if(l<nav.scrollLeft||r>nav.scrollLeft+nav.clientWidth)nav.scrollTo({left:l-16,behavior:"smooth"});}}});},{rootMargin:"-45% 0px -50% 0px"});
  Object.keys(map).forEach(function(id){var el=document.getElementById(id); if(el)io.observe(el);});
})();
</script>
{% endblock %}

{% block footer %}
<p class="stamp">Son üretim: {{ v.generated }}{% if v.feed_errors %} · {{ v.feed_errors }} kaynak okunamadı{% endif %}</p>
{% endblock %}
